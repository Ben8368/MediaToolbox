{
  "name": "mediatoolbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "tsx scripts/dev-supervisor.ts",
    "dev:supervisor": "tsx scripts/dev-supervisor.ts",
    "dev:web": "npm run dev -w @mediatoolbox/web",
    "dev:api": "npm run dev -w @mediatoolbox/api",
    "dev:desktop": "npm run dev -w @mediatoolbox/desktop",
    "assets:web-composer:verify": "tsx scripts/web-composer-assets.ts verify",
    "assets:web-composer:ensure": "tsx scripts/web-composer-assets.ts ensure",
    "assets:web-composer:install": "tsx scripts/web-composer-assets.ts install",
    "assets:web-composer:pack": "tsx scripts/web-composer-assets.ts pack",
    "psd:roundtrip": "tsx scripts/psd-roundtrip.ts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run test && npm run typecheck && npm run build",
    "release:preflight": "tsx scripts/release-preflight.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
