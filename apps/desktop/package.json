{
  "name": "@mediatoolbox/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "MediaToolbox desktop shell",
  "author": "MediaToolbox Contributors",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "electron --import tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:runtime": "npm run build -w @mediatoolbox/web && npm run build -w @mediatoolbox/api && npm run build -w @mediatoolbox/desktop",
    "rebuild:node-native": "npm rebuild better-sqlite3",
    "prepackage": "npm run build:runtime",
    "prepackage:win": "npm run build:runtime",
    "prepackage:mac": "npm run build:runtime",
    "prepackage:linux": "npm run build:runtime",
    "postpackage": "npm run rebuild:node-native",
    "postpackage:win": "npm run rebuild:node-native",
    "postpackage:mac": "npm run rebuild:node-native",
    "postpackage:linux": "npm run rebuild:node-native",
    "package": "electron-builder",
    "package:win": "electron-builder --win",
    "package:mac": "electron-builder --mac",
    "package:linux": "electron-builder --linux",
    "release:preflight": "tsx ../../scripts/release-preflight.ts"
  },
  "build": {
    "appId": "com.mediatoolbox.desktop",
    "productName": "MediaToolbox",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "src/preload.cjs"
    ],
    "extraResources": [
      {
        "from": "../../apps/web/dist",
        "to": "renderer"
      },
      {
        "from": "../../apps/api/dist",
        "to": "api"
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@mediatoolbox/contracts": "0.1.0",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "43.0.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
