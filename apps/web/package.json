{
  "name": "@mediatoolbox/web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm --prefix ../.. run assets:web-composer:ensure",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm --prefix ../.. run assets:web-composer:ensure",
    "build": "tsc && vite build",
    "verify": "npm run test && npm run typecheck && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediatoolbox/contracts": "0.1.0",
    "@mediatoolbox/shared": "0.1.0",
    "framer-motion": "^12.42.2",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  }
}
